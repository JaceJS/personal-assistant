APP_ENV=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/personal_assistant_db

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=voice-recordings
R2_PUBLIC_URL_BASE=xxx

OPENROUTER_API_KEY=xxx
STT_MODEL=openai/whisper-1
LLM_MODEL=google/gemini-2.5-flash-lite
RECEIPT_MODEL=google/gemini-2.5-flash-lite

CORS_ORIGINS=

LOG_LEVEL=INFO

# Leave empty to disable Sentry (SDK no-ops without a DSN)
SENTRY_DSN=

# only for local
TRUSTED_PROXY_IPS=
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/personal_assistant_db_test

# Comma-separated emails allowed to access /api/v1/admin/*. Empty means no
# admins -- never left open by default.
ADMIN_ALLOWLIST=
